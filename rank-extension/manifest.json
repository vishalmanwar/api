{
  "manifest_version": 3,
  "name": "Zipify Multi-Market Rank Agent",
  "version": "1.7.2",
  "description": "Single-leader persistent Amazon rank runner with safe stale-window handling and evidence-backed validation.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "debugger",
    "notifications",
    "cookies"
  ],
  "host_permissions": [
    "https://www.amazon.in/*",
    "https://ywrtgkdkntjyeqdnrbop.supabase.co/*",
    "https://www.amazon.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Zipify Rank Agent",
    "default_popup": "popup.html"
  },
  "incognito": "spanning"
}
